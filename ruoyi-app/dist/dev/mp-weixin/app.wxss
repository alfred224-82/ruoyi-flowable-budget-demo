
/* 20261016 四主题重设计：全局主题组件库（令牌兜底 + 共享 th- 组件类 + 图标/动效）。
   具体色板由页面根节点 :style="pageStyle"（themeMixin）注入并沿 DOM 继承。 */
/* ============================================================
   小账本 H5/App · 全局主题组件库（20261016 四主题重设计）
   移植自 主题样式交付包/components.css + svg_assets.css，适配 uni-app（view/text/image）。
   依赖：页面根节点通过 themeMixin 的 :style="pageStyle" 注入 theme.js 的设计令牌
        （--page-bg / --card-bg / --brand / --radius-card …），变量沿 DOM 继承到本文件的类。
   原则：组件只写一份，四主题通过 CSS 变量自动生效；类名统一 th- 前缀避免与页面 scoped 类冲突。
   ============================================================ */

/* ---------- 页面根兜底：未绑定主题时也有 sane 默认（等于主题1） ---------- */
page {
    --page-bg: #F6F8FC;
    --card-bg: #FFFFFF;
    --text: #1D2129;
    --text-sub: #86909C;
    --brand: #4F8FF7;
    --brand-2: #7AB8FF;
    --brand-weak: rgba(79, 143, 247, .10);
    --brand-grad: none;
    --danger: #E54545;
    --border: rgba(29, 33, 41, .08);
    --radius-card: 12px;
    --radius-btn: 24px;
    --radius-tag: 10px;
    --shadow-card: 0 2px 8px rgba(29, 33, 41, .06);
    background-color: var(--page-bg);
}

/* ---------- 卡片 ---------- */
.th-card {
    background: var(--card-bg);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 28rpx 32rpx;
    margin-bottom: 24rpx;
    animation: th-card-in var(--dur-card, 260ms) var(--ease, cubic-bezier(.22, .61, .36, 1)) both;
}
.th-card-title {
    font-size: 34rpx;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.th-card-flat { box-shadow: none; border: 1px solid var(--border);
}
/* 主题3：卡片描边 */
.theme-dark .th-card { border: 1px solid var(--border);
}

/* ---------- 按钮 ---------- */
.th-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 92rpx;
    width: 100%;
    border-radius: var(--radius-btn);
    font-size: 32rpx;
    font-weight: 600;
    transition: transform 120ms var(--ease, cubic-bezier(.22, .61, .36, 1));
}
.th-btn:active { transform: scale(var(--scale-press, .96));
}
.th-btn-primary {
    background-color: var(--brand);
    background-image: var(--brand-grad);
    color: #fff;
    box-shadow: var(--shadow-btn);
}
.th-btn-outline { color: var(--brand); border: 1px solid var(--brand); background: transparent; box-shadow: none;
}
.th-btn-danger { color: var(--danger); border: 1px solid var(--danger); background: transparent; box-shadow: none;
}
.th-btn-ghost { background: var(--brand-weak); color: var(--brand); box-shadow: none;
}
/* 主题3：主按钮青色描边发光 */
.theme-dark .th-btn-primary { border: 1px solid var(--border-hi);
}
/* 主题2：主按钮呼吸光 */
.theme-vivid .th-btn-primary { animation: th-breathe 2.4s ease-in-out infinite;
}

/* ---------- 状态标签 ---------- */
.th-tag {
    display: inline-flex;
    align-items: center;
    height: 40rpx;
    padding: 0 16rpx;
    border-radius: var(--radius-tag);
    font-size: 22rpx;
    font-weight: 500;
    background: var(--brand-weak);
    color: var(--brand);
}
.th-tag-green { background: rgba(24, 180, 120, .14); color: #18B478;
}
.th-tag-gold { background: rgba(255, 209, 102, .22); color: #B7791F;
}
.th-tag-red { background: rgba(229, 69, 69, .14); color: var(--danger);
}
.th-tag-gray { background: rgba(134, 144, 156, .14); color: var(--text-sub);
}
.theme-dark .th-tag { background: rgba(0, 229, 255, .14); color: var(--brand-2);
}
/* 主题4：贴纸感（圆角更大 + 轻微旋转） */
.theme-handdrawn .th-tag { border-radius: 28rpx; font-weight: 600; transform: rotate(-1.5deg);
}

/* ---------- 列表项（个人中心 / 设置） ---------- */
.th-list-item {
    display: flex;
    align-items: center;
    gap: 24rpx;
    padding: 28rpx 32rpx;
    background: var(--card-bg);
    border-bottom: 1px solid var(--border);
}
.th-list-item .txt { flex: 1; font-size: 30rpx; color: var(--text);
}
.th-list-item .extra { font-size: 24rpx; color: var(--text-sub);
}
.th-list-item .arrow { color: var(--text-sub); font-size: 28rpx;
}

/* ---------- 数据卡片（业绩 / 推广数据） ---------- */
.th-stat { flex: 1; text-align: center; padding: 28rpx 8rpx;
}
.th-stat-num {
    font-size: 48rpx;
    font-weight: 700;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
}
.theme-dark .th-stat-num { color: var(--brand-2);
}
.th-stat-label { font-size: 24rpx; color: var(--text-sub); margin-top: 8rpx;
}

/* 大金额（费用 / 净利） */
.th-amount { font-size: 44rpx; font-weight: 700; color: var(--brand); font-variant-numeric: tabular-nums;
}
.theme-dark .th-amount { color: var(--brand-2);
}

/* ---------- 进度条（成本构成） ---------- */
.th-bar-track { height: 16rpx; border-radius: 8rpx; background: var(--brand-weak); overflow: hidden;
}
.th-bar-fill { height: 100%; border-radius: 8rpx; background: var(--brand); transition: width 600ms var(--ease, ease);
}
.theme-dark .th-bar-fill { background: linear-gradient(90deg, var(--brand), var(--brand-2));
}
.theme-handdrawn .th-bar-track, .theme-handdrawn .th-bar-fill { border-radius: 99px;
}

/* ---------- 空状态 ---------- */
.th-empty { padding: 80rpx 48rpx; text-align: center; color: var(--text-sub); font-size: 28rpx;
}

/* ---------- 说明文字条 ---------- */
.th-tip {
    background: var(--brand-weak);
    border-radius: var(--radius-card);
    padding: 20rpx 24rpx;
    font-size: 24rpx;
    color: var(--text-sub);
    line-height: 1.5;
    margin-bottom: 24rpx;
}

/* ---------- 图标：CSS mask 方案（可随主题变色） ----------
   用法：<text class="th-ico" :style="{ '--ico': 'url(' + iconUrl + ')' }"></text>
   iconUrl 指向 static/theme/stickers/ico-xxx.svg */
.th-ico {
    display: inline-block;
    width: 44rpx;
    height: 44rpx;
    background: var(--icon-color, var(--brand));
    -webkit-mask: var(--ico) center / contain no-repeat;
    mask: var(--ico) center / contain no-repeat;
}
.th-ico.sm { width: 32rpx; height: 32rpx;
}
.th-ico.lg { width: 64rpx; height: 64rpx;
}
.th-ico.muted { background: var(--text-sub);
}
.theme-dark .th-ico { filter: drop-shadow(0 0 6px rgba(0, 229, 255, .45));
}

/* ---------- 动效 keyframes ---------- */
@keyframes th-card-in {
from { opacity: 0; transform: translateY(24rpx);
}
to { opacity: 1; transform: none;
}
}
@keyframes th-title-in {
from { opacity: 0; transform: translateY(20rpx);
}
to { opacity: 1; transform: none;
}
}
@keyframes th-breathe {
0%, 100% { box-shadow: 0 6px 18px rgba(245, 69, 92, .28);
}
50% { box-shadow: 0 6px 26px rgba(245, 69, 92, .48);
}
}
@keyframes th-sway {
0% { opacity: 0; transform: translateY(20rpx) rotate(-2deg);
}
60% { transform: translateY(0) rotate(1deg);
}
100% { opacity: 1; transform: none;
}
}
/* 主题4：标题摇摆入场 */
.theme-handdrawn .th-title { animation: th-sway 600ms var(--ease, cubic-bezier(.34, 1.4, .64, 1)) both;
}

/* ---------- 尊重系统「减弱动效」设置 ---------- */
@media (prefers-reduced-motion: reduce) {
.th-card, .th-btn-primary, .th-title { animation: none !important;
}
}
page {
    background-color: var(--page-bg, #F6F8FC);
    font-size: 28rpx;
    color: var(--text, #1D2129);
}
