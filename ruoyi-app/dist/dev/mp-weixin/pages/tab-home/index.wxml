<view class="page data-v-b153d3ad"><block wx:if="{{a}}"><view class="card data-v-b153d3ad" bindtap="{{b}}"><text class="title data-v-b153d3ad">🅰 大类看板</text><text class="desc data-v-b153d3ad">总览 / 大类卡片下钻 / 固定成本 / 风险预警</text></view><view class="grid data-v-b153d3ad"><view class="stat data-v-b153d3ad"><text class="num data-v-b153d3ad">{{c}}</text><text class="label data-v-b153d3ad">待审批</text></view><view class="stat data-v-b153d3ad"><text class="num data-v-b153d3ad">{{d}}</text><text class="label data-v-b153d3ad">进行中项目</text></view><view class="stat data-v-b153d3ad"><text class="num data-v-b153d3ad">{{e}}</text><text class="label data-v-b153d3ad">实际利润</text></view><view class="stat data-v-b153d3ad"><text class="num data-v-b153d3ad">{{f}}</text><text class="label data-v-b153d3ad">总支出</text></view></view><view wx:if="{{g}}" class="card warn data-v-b153d3ad" bindtap="{{i}}"><text class="desc data-v-b153d3ad">📋 您有 {{h}} 项审批待处理，点击查看</text></view></block><block wx:elif="{{j}}"><view class="card data-v-b153d3ad" bindtap="{{k}}"><text class="title data-v-b153d3ad">🅰 我的项目</text><text class="desc data-v-b153d3ad">项目卡片列表（数据限本人项目，后端按成员关系过滤）</text></view><view class="card data-v-b153d3ad" bindtap="{{l}}"><text class="title data-v-b153d3ad">收入确认</text><text class="desc data-v-b153d3ad">三态流转：待核验 → 财务核验 → 已核验（待核验不计利润）</text></view><view wx:if="{{m}}" class="card warn data-v-b153d3ad" bindtap="{{o}}"><text class="desc data-v-b153d3ad">⏳ 您有 {{n}} 笔收入确认待财务核验</text></view><view wx:if="{{p}}" class="card warn data-v-b153d3ad" bindtap="{{r}}"><text class="desc data-v-b153d3ad">❌ 您有 {{q}} 张报销单被驳回，请修改后重新提交</text></view></block><block wx:elif="{{s}}"><view class="section-title data-v-b153d3ad">待办事项</view><view wx:if="{{t}}" class="card data-v-b153d3ad"><text class="desc data-v-b153d3ad">加载中…</text></view><block wx:else><view wx:if="{{v}}" class="card data-v-b153d3ad" bindtap="{{x}}"><text class="title data-v-b153d3ad">🔔 未读通知 {{w}} 条</text><text class="desc data-v-b153d3ad">审批结果 / 补票提醒</text></view><view wx:for="{{y}}" wx:for-item="bill" wx:key="d" class="card warn data-v-b153d3ad" bindtap="{{bill.e}}"><text class="title data-v-b153d3ad">❌ 报销单被驳回：{{bill.a}}</text><text class="desc data-v-b153d3ad">金额 ¥{{bill.b}}　原因：{{bill.c}}</text></view><view wx:for="{{z}}" wx:for-item="sup" wx:key="d" class="card warn data-v-b153d3ad" bindtap="{{sup.e}}"><text class="title data-v-b153d3ad">🧾 发票待补传：{{sup.a}}</text><text class="desc data-v-b153d3ad">预占 ¥{{sup.b}}　预计补票日 {{sup.c}}</text></view><view wx:if="{{A}}" class="card data-v-b153d3ad"><text class="desc data-v-b153d3ad">✅ 暂无待办，去发起报销吧</text></view></block></block><block wx:else><view class="section-title data-v-b153d3ad"><text class="data-v-b153d3ad">审批通知 / 预警</text><text class="link data-v-b153d3ad" bindtap="{{B}}">全部已读</text></view><view wx:if="{{C}}" class="card data-v-b153d3ad"><text class="desc data-v-b153d3ad">暂无通知（重操作请在 PC 端完成）</text></view><view wx:for="{{D}}" wx:for-item="msg" wx:key="d" class="{{['card', 'data-v-b153d3ad', msg.e && 'unread']}}" bindtap="{{msg.f}}"><text class="title data-v-b153d3ad">{{msg.a}}</text><text class="desc data-v-b153d3ad">{{msg.b}}</text><text class="time data-v-b153d3ad">{{msg.c}}</text></view></block></view>