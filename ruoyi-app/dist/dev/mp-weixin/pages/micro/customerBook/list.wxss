
/* ★ 页面整体 */
.page.data-v-7e18bce6 {
    min-height: 100vh;
    padding: 0 24rpx 140rpx;
    background: var(--page-bg, #FFF9F0);
    display: flex;
    flex-direction: column;
}

/* ★ 页面标题 */
.page-header.data-v-7e18bce6 {
    padding: 32rpx 0 16rpx;
}
.page-title.data-v-7e18bce6 {
    font-size: 44rpx;
    font-weight: bold;
    color: var(--text, #3A3A3A);
}

/* ★ Tab 切换栏 */
.tab-bar.data-v-7e18bce6 {
    display: flex;
    align-items: center;
    gap: 48rpx;
    padding: 16rpx 0 20rpx;
    border-bottom: 1rpx solid var(--border, rgba(58,58,58,.08));
    margin-bottom: 24rpx;
}
.tab-item.data-v-7e18bce6 {
    position: relative;
    padding: 8rpx 0 16rpx;
}
.tab-text.data-v-7e18bce6 {
    font-size: 30rpx;
    color: var(--text-sub, #9E9E9E);
    transition: color 0.2s;
}
.tab-item.active .tab-text.data-v-7e18bce6 {
    font-size: 32rpx;
    font-weight: bold;
    color: var(--brand, #FFB347);
}
.tab-indicator.data-v-7e18bce6 {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 48rpx;
    height: 6rpx;
    border-radius: 3rpx;
    background: var(--brand, #FFB347);
}

/* ★ 列表滚动区 */
.list-scroll.data-v-7e18bce6 {
    flex: 1;
    min-height: 0;
}

/* ★ 活动卡片 */
.act-list.data-v-7e18bce6 {
    display: flex;
    flex-direction: column;
    gap: 24rpx;
}
.act-card.data-v-7e18bce6 {
    background: var(--card-bg, #FFFFFF);
    border-radius: var(--radius-card, 18px);
    padding: 32rpx;
    box-shadow: var(--shadow-card, 0 3px 10px rgba(255,179,71,.14));
    transition: transform 0.15s;
}
.act-card.data-v-7e18bce6:active {
    transform: scale(0.98);
}

/* 卡片头部 */
.card-top.data-v-7e18bce6 {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20rpx;
}
.act-title.data-v-7e18bce6 {
    flex: 1;
    font-size: 32rpx;
    font-weight: bold;
    color: var(--text, #3A3A3A);
    line-height: 1.4;
    margin-right: 16rpx;
}

/* 标签行 */
.tag-row.data-v-7e18bce6 {
    display: flex;
    align-items: center;
    gap: 12rpx;
    flex-shrink: 0;
}
.tag.data-v-7e18bce6 {
    font-size: 22rpx;
    padding: 4rpx 16rpx;
    border-radius: var(--radius-tag, 14rpx);
    white-space: nowrap;
}
.tag-activity.data-v-7e18bce6 {
    background: rgba(255,179,71,.12);
    color: #E09A30;
}
.tag-locked.data-v-7e18bce6 {
    background: rgba(244,67,54,.10);
    color: #E5544B;
}
.tag-ongoing.data-v-7e18bce6 {
    background: rgba(76,175,80,.12);
    color: #4CAF50;
    font-weight: bold;
}
.tag-ended.data-v-7e18bce6 {
    background: rgba(158,158,158,.12);
    color: #9E9E9E;
}
.tag-draft.data-v-7e18bce6 {
    background: rgba(244,67,54,.10);
    color: #E5544B;
}

/* 卡片信息区 */
.card-info.data-v-7e18bce6 {
    padding: 16rpx 0;
    border-top: 1rpx solid var(--border, rgba(58,58,58,.06));
    border-bottom: 1rpx solid var(--border, rgba(58,58,58,.06));
}
.info-line.data-v-7e18bce6 {
    display: flex;
    align-items: center;
    margin-bottom: 10rpx;
}
.info-line.data-v-7e18bce6:last-child {
    margin-bottom: 0;
}
.info-label.data-v-7e18bce6 {
    font-size: 26rpx;
    color: var(--text-sub, #9E9E9E);
    flex-shrink: 0;
}
.info-value.data-v-7e18bce6 {
    font-size: 26rpx;
    color: var(--text, #3A3A3A);
}
.info-price.data-v-7e18bce6 {
    font-size: 30rpx;
    font-weight: bold;
    color: var(--brand, #FFB347);
}
.info-remain.data-v-7e18bce6 {
    font-size: 24rpx;
    color: var(--brand, #FFB347);
    margin-left: 8rpx;
}

/* 卡片底部 */
.card-footer.data-v-7e18bce6 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16rpx;
}
.cancel-wrap.data-v-7e18bce6 {
    flex: 1;
}
.cancel-btn.data-v-7e18bce6 {
    font-size: 24rpx;
    color: #f56c6c;
    background: #fff;
    border: 2rpx solid #f56c6c;
    border-radius: 8rpx;
    padding: 8rpx 24rpx;
}
.detail-wrap.data-v-7e18bce6 {
    display: flex;
    align-items: center;
    gap: 4rpx;
    flex-shrink: 0;
}
.detail-btn.data-v-7e18bce6 {
    font-size: 28rpx;
    color: var(--brand, #FFB347);
    font-weight: 600;
}
.detail-arrow.data-v-7e18bce6 {
    font-size: 32rpx;
    color: var(--brand, #FFB347);
    font-weight: bold;
}

/* ★ 加载 / 空状态 */
.loading.data-v-7e18bce6, .empty.data-v-7e18bce6 {
    text-align: center;
    padding: 120rpx 0;
}
.loading-text.data-v-7e18bce6, .empty-text.data-v-7e18bce6 {
    color: var(--text-sub, #9E9E9E);
    font-size: 28rpx;
}
