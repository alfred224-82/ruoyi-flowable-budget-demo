
.page.data-v-20c5f713 { padding: 24rpx; padding-bottom: 140rpx; background: var(--page-bg, #f5f6f8); min-height: 100vh;
}
.card.data-v-20c5f713 { background: var(--card-bg, #fff); border-radius: var(--radius-card, 16rpx); padding: 32rpx; margin-bottom: 24rpx; box-shadow: var(--shadow-card, none); color: var(--text, #303133);
}
.user-card.data-v-20c5f713 { display: flex; align-items: center;
}
.avatar-img.data-v-20c5f713 { width: 96rpx; height: 96rpx; border-radius: 50%;
}
.avatar.data-v-20c5f713 { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--brand, #e6a23c); color: #fff; font-size: 40rpx; display: flex; align-items: center; justify-content: center;
}
.user-info.data-v-20c5f713 { margin-left: 24rpx;
}
.name.data-v-20c5f713 { font-size: 32rpx; font-weight: bold; display: block; color: var(--text, #303133);
}
.role.data-v-20c5f713 { font-size: 24rpx; color: var(--brand, #e6a23c); margin-top: 8rpx; display: block;
}
.card-title.data-v-20c5f713 { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 12rpx; color: var(--text, #303133);
}
.pay-desc.data-v-20c5f713 { font-size: 26rpx; color: var(--text-sub, #606266); line-height: 1.6;
}
.link-text.data-v-20c5f713 { font-size: 28rpx; color: var(--brand, #409eff);
}
.btn-logout.data-v-20c5f713 { background: var(--card-bg, #fff); color: var(--danger, #f56c6c); border: 2rpx solid var(--danger, #f56c6c); border-radius: var(--radius-btn, 12rpx); margin-top: 40rpx; font-size: 30rpx;
}

/* ★手绘主题装饰贴纸 */
