<view class="page data-v-b7d30e50"><view wx:if="{{a}}" class="loading data-v-b7d30e50">加载中…</view><block wx:elif="{{b}}"><view class="card data-v-b7d30e50"><view class="status-bar data-v-b7d30e50" style="{{'color:' + d}}">{{c}}</view><view class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">顾客</text><text class="data-v-b7d30e50">{{e}}</text></view><view class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">手机号</text><text class="data-v-b7d30e50">{{f}}</text></view><view class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">服务项目</text><text class="data-v-b7d30e50">{{g}}</text></view><view class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">预约时间</text><text class="data-v-b7d30e50">{{h}}</text></view><view class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">金额</text><text class="amount data-v-b7d30e50">{{i}}</text></view><view class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">收款状态</text><text class="data-v-b7d30e50" style="{{'color:' + k}}">{{j}}</text></view><view wx:if="{{l}}" class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">业务员</text><text class="data-v-b7d30e50">{{m}}</text></view><view wx:if="{{n}}" class="info-row data-v-b7d30e50"><text class="label data-v-b7d30e50">备注</text><text class="data-v-b7d30e50">{{o}}</text></view></view><view class="actions data-v-b7d30e50"><button wx:if="{{p}}" class="btn primary data-v-b7d30e50" bindtap="{{q}}">完成服务</button><button wx:if="{{r}}" class="btn success data-v-b7d30e50" bindtap="{{s}}">标记收款</button><button wx:if="{{t}}" class="btn warn data-v-b7d30e50" bindtap="{{v}}">取消预约</button></view></block></view>