
.page.data-v-bf901a49 { padding: 24rpx; padding-bottom: 140rpx; background: var(--page-bg, #f5f6f8); min-height: 100vh;
}

/* ★ 主题渐变头部（背景/文字色由模板 :style 注入，此处为兜底） */
.shop-header.data-v-bf901a49 {
    background: var(--tgrad, linear-gradient(135deg, #4F8FF7 0%, #7AB8FF 100%));
    border-radius: var(--radius-card, 16rpx);
    padding: 48rpx 36rpx;
    margin-bottom: 32rpx;
}
.shop-name.data-v-bf901a49 { font-size: 40rpx; font-weight: bold; color: #fff; display: block;
}
.shop-desc.data-v-bf901a49 { font-size: 28rpx; color: rgba(255,255,255,0.85); margin-top: 12rpx; display: block;
}

/* ★ 板块通用 */
.section.data-v-bf901a49 { margin-bottom: 32rpx;
}
.section-header.data-v-bf901a49 { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx;
}
.section-title.data-v-bf901a49 { font-size: 34rpx; font-weight: bold; color: var(--text, #1a1a1a);
}
.section-more.data-v-bf901a49 { font-size: 26rpx; color: var(--text-sub, #909399);
}

/* ★ 活动大图卡片 */
.act-cards.data-v-bf901a49 { display: flex; flex-direction: column; gap: 20rpx;
}
.act-card.data-v-bf901a49 {
    position: relative;
    height: 320rpx;
    border-radius: 20rpx;
    overflow: hidden;
}
.act-bg.data-v-bf901a49 { position: absolute; top: 0; left: 0; width: 100%; height: 100%;
}
.act-bg-default.data-v-bf901a49 { background: var(--tgrad, linear-gradient(135deg, #4F8FF7, #7AB8FF));
}
.act-overlay.data-v-bf901a49 {
    position: absolute; bottom: 0; left: 0; right: 0; height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 100%);
}
.act-bottom.data-v-bf901a49 {
    position: absolute; bottom: 0; left: 0; right: 0;
    display: flex; align-items: flex-end; justify-content: space-between;
    padding: 28rpx 32rpx;
}
.act-text.data-v-bf901a49 { flex: 1;
}
.act-title.data-v-bf901a49 { font-size: 36rpx; font-weight: bold; color: #fff; display: block; line-height: 1.3;
}
.act-status.data-v-bf901a49 { font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: block;
}
.act-btn.data-v-bf901a49 {
    background: var(--card-bg, #fff);
    color: var(--text, #1a1a1a);
    font-size: 26rpx;
    font-weight: 600;
    padding: 14rpx 32rpx;
    border-radius: 40rpx;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 20rpx;
}

/* ★ 自助预约卡片 */
.booking-card.data-v-bf901a49 {
    display: flex;
    align-items: center;
    background: var(--card-bg, #fff);
    border-radius: var(--radius-card, 20rpx);
    padding: 36rpx 32rpx;
    box-shadow: var(--shadow-card, 0 4rpx 20rpx rgba(0,0,0,0.04));
}
.booking-card.data-v-bf901a49:active { transform: scale(0.98);
}
.booking-icon.data-v-bf901a49 { font-size: 64rpx; margin-right: 24rpx; flex-shrink: 0;
}
.booking-info.data-v-bf901a49 { flex: 1;
}
.booking-title.data-v-bf901a49 { font-size: 34rpx; font-weight: bold; color: var(--text, #1a1a1a); display: block;
}
.booking-desc.data-v-bf901a49 { font-size: 26rpx; color: var(--text-sub, #909399); margin-top: 8rpx; display: block;
}
.booking-btn.data-v-bf901a49 {
    background: var(--brand, #409eff);
    color: #fff;
    font-size: 28rpx;
    font-weight: 600;
    padding: 18rpx 40rpx;
    border-radius: 40rpx;
    white-space: nowrap;
    flex-shrink: 0;
}

/* ★T22.5 门店排班 */
.store-schedule.data-v-bf901a49 { display: flex; flex-direction: column; gap: 20rpx;
}
.ss-day.data-v-bf901a49 { background: var(--card-bg, #fff); border-radius: var(--radius-card, 16rpx); padding: 24rpx;
}
.ss-date.data-v-bf901a49 { font-size: 28rpx; font-weight: bold; color: var(--text, #303133); display: block; margin-bottom: 16rpx;
}
.ss-staff-list.data-v-bf901a49 { display: flex; flex-direction: column; gap: 16rpx;
}
.ss-staff.data-v-bf901a49 { display: flex; align-items: center; gap: 16rpx;
}
.ss-avatar.data-v-bf901a49 { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; background: var(--brand-weak, #f0f2f5);
}
.ss-avatar-default.data-v-bf901a49 { display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.ss-info.data-v-bf901a49 { flex: 1;
}
.ss-name.data-v-bf901a49 { font-size: 28rpx; color: var(--text, #303133); font-weight: 500; display: block;
}
.ss-time.data-v-bf901a49 { font-size: 24rpx; color: var(--text-sub, #909399); margin-top: 4rpx; display: block;
}
.ss-shift.data-v-bf901a49 { display: inline-block; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 4rpx; margin-right: 8rpx; color: #fff;
}
.ss-shift-morning.data-v-bf901a49 { background: var(--brand, #409eff);
}
.ss-shift-evening.data-v-bf901a49 { background: #e6a23c;
}

/* ★ 通用 */
.loading.data-v-bf901a49 { text-align: center; color: var(--text-sub, #909399); padding: 40rpx 0; font-size: 26rpx;
}
.empty-tip.data-v-bf901a49 { text-align: center; color: var(--text-sub, #c0c4cc); padding: 40rpx 0; font-size: 26rpx;
}

/* ★手绘主题装饰贴纸 */
.page.data-v-bf901a49 { position: relative;
}
.sticker.data-v-bf901a49 { position: absolute; opacity: .8; pointer-events: none; z-index: 0;
}
.shop-header.data-v-bf901a49, .section.data-v-bf901a49, .booking-card.data-v-bf901a49 { position: relative; z-index: 1;
}
.sticker-star-tl.data-v-bf901a49 { top: 16rpx; left: 16rpx; width: 56rpx; height: 56rpx; transform: rotate(-10deg);
}
.sticker-sparkle-tl.data-v-bf901a49 { top: 40rpx; left: 60rpx; width: 36rpx; height: 36rpx; transform: rotate(15deg);
}
.sticker-sparkle-tr.data-v-bf901a49 { top: 20rpx; right: 40rpx; width: 36rpx; height: 36rpx; transform: rotate(-12deg);
}
.sticker-bubble-tr.data-v-bf901a49 { top: 10rpx; right: 10rpx; width: 64rpx; height: 64rpx; transform: rotate(8deg);
}
.sticker-bubble-bl.data-v-bf901a49 { bottom: 160rpx; left: 16rpx; width: 72rpx; height: 72rpx; transform: rotate(-6deg);
}
.sticker-sparkle-bl.data-v-bf901a49 { bottom: 200rpx; left: 80rpx; width: 36rpx; height: 36rpx; transform: rotate(20deg);
}
.sticker-cloud-br.data-v-bf901a49 { bottom: 140rpx; right: 16rpx; width: 90rpx; height: 72rpx; transform: rotate(5deg);
}
