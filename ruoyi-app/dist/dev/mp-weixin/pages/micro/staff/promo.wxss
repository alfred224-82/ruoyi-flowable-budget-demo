
.page.data-v-6133f5f7 { padding: 24rpx; padding-bottom: 140rpx; min-height: 100vh; background: var(--page-bg, #f5f6f8);
}
.card.data-v-6133f5f7 { background: var(--card-bg, #fff); border-radius: var(--radius-card, 16rpx); padding: 28rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-card, none);
}
.card-title.data-v-6133f5f7 { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; color: var(--text, #303133);
}
.code-area.data-v-6133f5f7 { text-align: center;
}
.qr-img.data-v-6133f5f7 { width: 360rpx; height: 360rpx; display: block; margin: 0 auto 16rpx;
}
.qr-tip.data-v-6133f5f7 { font-size: 24rpx; color: var(--text-sub, #909399); display: block; text-align: center; margin-bottom: 12rpx;
}
.scene.data-v-6133f5f7 { font-size: 26rpx; color: var(--text-sub, #606266); display: block; word-break: break-all; margin-bottom: 12rpx;
}
.status.data-v-6133f5f7 { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: var(--radius-tag, 6rpx);
}
.status.on.data-v-6133f5f7 { background: #f0f9eb; color: #67c23a;
}
.status.off.data-v-6133f5f7 { background: #fef0f0; color: #f56c6c;
}
.time.data-v-6133f5f7 { font-size: 22rpx; color: var(--text-sub, #909399); display: block; margin-top: 8rpx;
}
.stat-row.data-v-6133f5f7 { text-align: center;
}
.stat-num.data-v-6133f5f7 { font-size: 48rpx; font-weight: bold; color: var(--brand, #409eff); display: block;
}
.stat-label.data-v-6133f5f7 { font-size: 24rpx; color: var(--text-sub, #909399); display: block; margin-top: 8rpx;
}
.reward-row.data-v-6133f5f7 { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--border, #f0f2f5);
}
.reward-row.data-v-6133f5f7:last-child { border-bottom: none;
}
.reward-type.data-v-6133f5f7 { flex: 1; font-size: 28rpx; color: var(--text, #303133);
}
.reward-amount.data-v-6133f5f7 { width: 160rpx; text-align: right; font-size: 28rpx; color: #f56c6c; font-weight: bold;
}
.reward-status.data-v-6133f5f7 { width: 120rpx; text-align: right; font-size: 24rpx; color: var(--text-sub, #909399);
}
.btn.data-v-6133f5f7 { background: var(--brand, #409eff); color: #fff; border-radius: var(--radius-btn, 12rpx); font-size: 28rpx; margin-top: 20rpx;
}
.btn-regen.data-v-6133f5f7 { background: var(--card-bg, #fff); color: var(--brand, #409eff); border: 2rpx solid var(--brand, #409eff); border-radius: var(--radius-btn, 12rpx); font-size: 26rpx; margin-top: 20rpx;
}
.loading.data-v-6133f5f7, .empty.data-v-6133f5f7 { text-align: center; color: var(--text-sub, #909399); padding: 60rpx 0;
}
