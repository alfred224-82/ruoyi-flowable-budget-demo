
.page.data-v-f75cdadd { padding: 32rpx 24rpx; min-height: 100vh; background: var(--tbg, #f5f6f8);
}
.header.data-v-f75cdadd { padding: 24rpx 8rpx 40rpx;
}
.title.data-v-f75cdadd { font-size: 44rpx; font-weight: bold; color: var(--ttext, #303133); display: block;
}
.subtitle.data-v-f75cdadd { font-size: 24rpx; color: var(--ttext2, #909399); margin-top: 12rpx; display: block;
}
.store-card.data-v-f75cdadd { display: flex; align-items: center; background: #fff; border-radius: var(--tradius, 16rpx); padding: 28rpx; margin-bottom: 20rpx; border: 2rpx solid transparent;
}
.store-card.active.data-v-f75cdadd { border-color: var(--tp, #409eff); background: var(--tp-soft, #ecf5ff);
}
.logo.data-v-f75cdadd { width: 96rpx; height: 96rpx; border-radius: var(--tradius, 16rpx); flex-shrink: 0;
}
.logo-ph.data-v-f75cdadd { background: var(--tp, #409eff); color: #fff; font-size: 40rpx; display: flex; align-items: center; justify-content: center;
}
.info.data-v-f75cdadd { flex: 1; margin-left: 24rpx; overflow: hidden;
}
.name.data-v-f75cdadd { font-size: 32rpx; font-weight: bold; color: var(--ttext, #303133); display: block;
}
.tags.data-v-f75cdadd { display: flex; flex-wrap: wrap; margin-top: 12rpx;
}
.tag.data-v-f75cdadd { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; margin-right: 12rpx; margin-bottom: 8rpx;
}
.tag.role.data-v-f75cdadd { background: var(--tp-soft, #ecf5ff); color: var(--tp, #409eff);
}
.tag.edition.data-v-f75cdadd { background: #f4f4f5; color: #909399;
}
.tag.edition.micro_pro.data-v-f75cdadd { background: #fdf6ec; color: #e6a23c;
}
.tag.edition.micro_lite.data-v-f75cdadd { background: #f0f9eb; color: #67c23a;
}
.tag.industry.data-v-f75cdadd { background: #f4f4f5; color: #606266;
}
.city.data-v-f75cdadd { font-size: 22rpx; color: #c0c4cc; margin-top: 4rpx; display: block;
}
.check.data-v-f75cdadd { font-size: 40rpx; color: var(--tp, #409eff); font-weight: bold; margin-left: 16rpx;
}
.remember.data-v-f75cdadd { display: flex; align-items: center; padding: 24rpx 8rpx;
}
.box.data-v-f75cdadd { width: 36rpx; height: 36rpx; border: 2rpx solid #dcdfe6; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; margin-right: 16rpx;
}
.box.on.data-v-f75cdadd { background: var(--tp, #409eff); border-color: var(--tp, #409eff);
}
.remember-text.data-v-f75cdadd { font-size: 26rpx; color: var(--ttext2, #606266);
}
.btn-confirm.data-v-f75cdadd { background: var(--tp, #409eff); color: #fff; border-radius: var(--tradius, 12rpx); margin-top: 32rpx; font-size: 32rpx;
}
.btn-confirm[disabled].data-v-f75cdadd { background: #a0cfff; color: #fff;
}
.loading.data-v-f75cdadd, .empty.data-v-f75cdadd { text-align: center; color: var(--ttext2, #909399); padding: 120rpx 0; font-size: 28rpx;
}

/* M27 T27.5：4 风格变体——结构文案一致，仅配色/圆角/氛围不同 */
.page.theme-vivid.data-v-f75cdadd { background: var(--tgrad);
}
.page.theme-handdrawn.data-v-f75cdadd { background: var(--tgrad);
}
.page.theme-dark.data-v-f75cdadd { background: var(--tgrad);
}
.page.theme-dark .store-card.data-v-f75cdadd { background: #16213E;
}
.page.theme-dark .name.data-v-f75cdadd { color: #EAEAEA;
}
.page.theme-dark .btn-confirm.data-v-f75cdadd { box-shadow: 0 0 16rpx var(--tp, #00E5FF);
}
