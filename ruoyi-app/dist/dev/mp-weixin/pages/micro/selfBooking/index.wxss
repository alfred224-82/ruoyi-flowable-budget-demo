
.page.data-v-7a545587 { padding: 0 24rpx 160rpx; background: #f5f6f8; min-height: 100vh; box-sizing: border-box;
}

/* ★ 顶部说明 */
.intro.data-v-7a545587 { padding: 28rpx 0 8rpx;
}
.intro-title.data-v-7a545587 { display: block; text-align: center; font-size: 30rpx; color: #606266;
}
.intro-tip.data-v-7a545587 {
  margin-top: 24rpx; background: #fff; border-radius: 12rpx;
  padding: 24rpx 20rpx; text-align: center;
  font-size: 28rpx; color: #303133;
}

/* ★ 分区 */
.section.data-v-7a545587 { margin-top: 40rpx;
}
.section-header.data-v-7a545587 { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx;
}
.section-title-wrap.data-v-7a545587 { display: flex; align-items: center;
}
.section-title.data-v-7a545587 { font-size: 36rpx; font-weight: bold; color: #1a1a1a;
}
.req-star.data-v-7a545587 { font-size: 32rpx; color: #f56c6c; margin-left: 6rpx; font-weight: bold;
}
.section-link.data-v-7a545587 { font-size: 28rpx; color: #2b7de9; font-weight: 600;
}
.link-arrow.data-v-7a545587 { font-size: 28rpx; color: #2b7de9; margin-left: 4rpx;
}

/* 门形小图标 */
.door-icon.data-v-7a545587 { width: 26rpx; height: 34rpx; background: #7ba4f0; border-radius: 6rpx; margin-right: 12rpx; position: relative;
}
.door-icon.data-v-7a545587::after {
  content: ''; position: absolute; right: 5rpx; top: 14rpx;
  width: 4rpx; height: 8rpx; background: #fff; border-radius: 2rpx;
}

/* ── 房间网格 ── */
.room-grid.data-v-7a545587 { display: flex; flex-wrap: wrap; gap: 16rpx;
}
.room-card.data-v-7a545587 {
  width: calc((100% - 32rpx) / 3); flex-shrink: 0;
  background: #fff; border-radius: 16rpx; padding: 16rpx;
  box-sizing: border-box; border: 3rpx solid transparent;
}
.room-card.selected.data-v-7a545587 { border-color: #2b7de9;
}
.room-card.data-v-7a545587:active { transform: scale(0.97);
}
.room-img-wrap.data-v-7a545587 { position: relative;
}
.room-img.data-v-7a545587 { width: 100%; height: 160rpx; border-radius: 10rpx; display: block;
}
.room-img-placeholder.data-v-7a545587 { width: 100%; height: 160rpx; border-radius: 10rpx; background: linear-gradient(135deg, #e8f0fe, #f0f6ff);
}
.check-badge.data-v-7a545587 {
  position: absolute; right: -8rpx; bottom: -8rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #2b7de9; border: 3rpx solid #fff;
  display: flex; align-items: center; justify-content: center;
}
.check-badge-icon.data-v-7a545587 { color: #fff; font-size: 24rpx; font-weight: bold;
}
.room-name.data-v-7a545587 { display: block; font-size: 32rpx; font-weight: bold; color: #1a1a1a; margin-top: 20rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.room-cap.data-v-7a545587 { display: block; font-size: 28rpx; color: #909399; margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.room-foot.data-v-7a545587 { display: flex; justify-content: center; margin-top: 20rpx;
}
.tag-idle.data-v-7a545587 {
  padding: 12rpx 32rpx; border-radius: 32rpx;
  background: #e5f6ef; color: #3eb589; font-size: 26rpx; font-weight: 600;
}
.btn-select.data-v-7a545587 {
  padding: 12rpx 40rpx; border-radius: 32rpx;
  border: 2rpx solid #2b7de9; color: #2b7de9; font-size: 26rpx; font-weight: 600;
}

/* ── 助教列表 ── */
.staff-list.data-v-7a545587 { display: flex; flex-direction: column; gap: 20rpx;
}
.staff-row.data-v-7a545587 {
  display: flex; align-items: center; background: #fff; border-radius: 16rpx;
  padding: 28rpx 24rpx; border: 3rpx solid transparent;
}
.staff-row.selected.data-v-7a545587 { border-color: #2b7de9; background: #f6faff;
}
.staff-row.data-v-7a545587:active { transform: scale(0.98);
}
.staff-avatar.data-v-7a545587 { width: 120rpx; height: 120rpx; border-radius: 50%; flex-shrink: 0;
}
.staff-avatar-placeholder.data-v-7a545587 {
  width: 120rpx; height: 120rpx; border-radius: 50%; background: #2b7de9;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.staff-avatar-text.data-v-7a545587 { color: #fff; font-size: 44rpx;
}
.staff-info.data-v-7a545587 { flex: 1; margin-left: 24rpx; min-width: 0;
}
.staff-name.data-v-7a545587 { display: block; font-size: 34rpx; font-weight: bold; color: #1a1a1a;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.staff-tag.data-v-7a545587 {
  display: inline-block; margin-top: 10rpx; padding: 4rpx 18rpx;
  background: #a5a1e0; border-radius: 8rpx; color: #fff; font-size: 24rpx;
}
.staff-status.data-v-7a545587 { display: flex; align-items: center; margin-top: 12rpx;
}
.staff-status-icon.data-v-7a545587 { font-size: 26rpx; color: #3eb589; margin-right: 6rpx;
}
.staff-status-text.data-v-7a545587 { font-size: 26rpx; color: #3eb589;
}
.staff-btn.data-v-7a545587 {
  flex-shrink: 0; padding: 14rpx 44rpx; border-radius: 36rpx;
  border: 2rpx solid #2b7de9; color: #2b7de9; font-size: 28rpx; font-weight: 600;
}
.staff-btn-on.data-v-7a545587 { background: #2b7de9; color: #fff;
}

/* ★ 底部操作栏 */
.bottom-bar.data-v-7a545587 {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 30rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); z-index: 10;
}
.summary.data-v-7a545587 { flex: 1; display: flex; align-items: center; min-width: 0; margin-right: 20rpx;
}
.summary-label.data-v-7a545587 { font-size: 28rpx; color: #606266; flex-shrink: 0;
}
.summary-empty.data-v-7a545587 { font-size: 28rpx; color: #c0c4cc;
}
.summary-content.data-v-7a545587 { display: flex; align-items: center; min-width: 0;
}
.summary-room.data-v-7a545587 { font-size: 30rpx; font-weight: bold; color: #1a1a1a;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.summary-plus.data-v-7a545587 { font-size: 30rpx; color: #2b7de9; font-weight: bold; margin: 0 8rpx;
}
.summary-staff-count.data-v-7a545587 { font-size: 30rpx; color: #2b7de9; font-weight: bold;
}
.summary-staff.data-v-7a545587 { font-size: 30rpx; font-weight: bold; color: #1a1a1a;
}
.btn-confirm.data-v-7a545587 {
  flex-shrink: 0; background: #2b7de9; color: #fff;
  font-size: 32rpx; font-weight: 600; padding: 24rpx 64rpx; border-radius: 44rpx;
}
.btn-confirm.disabled.data-v-7a545587 { background: #c0c4cc;
}
.btn-confirm.data-v-7a545587:active:not(.disabled) { opacity: 0.85;
}

/* ★ 通用 */
.loading.data-v-7a545587 { text-align: center; color: #909399; padding: 60rpx 0; font-size: 28rpx;
}
.empty.data-v-7a545587 { text-align: center; color: #c0c4cc; padding: 60rpx 0; font-size: 28rpx;
}
