
/* ★首页改版：固定一屏不滚动（page 为 flex 列，成本构成卡吸收剩余高度） */
.page.data-v-d00c6a62 { height: 100vh; box-sizing: border-box; padding: 20rpx 24rpx 120rpx; overflow: hidden; display: flex; flex-direction: column; background: var(--page-bg, #f5f6f8);
}
/* ★v1.43 欢迎区：主题渐变 + 半透明装饰光斑 + 投影 */
.welcome-bar.data-v-d00c6a62 { flex-shrink: 0; position: relative; overflow: hidden; padding: 28rpx 32rpx; border-radius: 24rpx; margin-bottom: 16rpx; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}
.welcome-deco.data-v-d00c6a62 { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.14);
}
.welcome-deco.deco-1.data-v-d00c6a62 { width: 220rpx; height: 220rpx; top: -80rpx; right: -60rpx;
}
.welcome-deco.deco-2.data-v-d00c6a62 { width: 140rpx; height: 140rpx; bottom: -50rpx; right: 120rpx; background: rgba(255, 255, 255, 0.1);
}
.welcome-content.data-v-d00c6a62 { position: relative;
}
.welcome-text.data-v-d00c6a62 { font-size: 34rpx; font-weight: bold; display: block;
}
.welcome-sub.data-v-d00c6a62 { font-size: 24rpx; display: block; margin-top: 8rpx;
}
.card.data-v-d00c6a62 { background: var(--card-bg, #fff); border-radius: var(--radius-card, 16rpx); padding: 32rpx; margin-bottom: 24rpx; box-shadow: var(--shadow-card, 0 2rpx 12rpx rgba(0, 0, 0, 0.04));
}
.card.upgrade.data-v-d00c6a62 { border-left: 8rpx solid var(--brand, #409eff);
}
.card-head.data-v-d00c6a62 { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx;
}
.card-head .card-title.data-v-d00c6a62 { margin-bottom: 0;
}
.card-title.data-v-d00c6a62 { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; color: var(--text, #303133);
}
.link.data-v-d00c6a62 { font-size: 24rpx; color: var(--brand, #409eff);
}
.desc.data-v-d00c6a62 { font-size: 26rpx; color: #e6a23c;
}
.card.upgrade .desc.data-v-d00c6a62 { color: #909399;
}
/* 最新活动（★v1.43 带封面缩略图） */
.activity-row.data-v-d00c6a62 { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f2f5;
}
.activity-row.data-v-d00c6a62:last-child { border-bottom: none;
}
.activity-thumb.data-v-d00c6a62 { width: 96rpx; height: 96rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0;
}
.thumb-default.data-v-d00c6a62 { display: flex; align-items: center; justify-content: center;
}
.thumb-icon.data-v-d00c6a62 { font-size: 40rpx;
}
.activity-main.data-v-d00c6a62 { flex: 1; overflow: hidden;
}
.activity-title.data-v-d00c6a62 { display: block; font-size: 28rpx; color: var(--text, #303133); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.activity-time.data-v-d00c6a62 { display: block; font-size: 22rpx; color: var(--text-sub, #909399); margin-top: 6rpx;
}
.type-badge.data-v-d00c6a62 { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 6rpx; margin-left: 16rpx; white-space: nowrap;
}
.type-activity.data-v-d00c6a62 { background: #ecf5ff; color: #409eff;
}
.type-notice.data-v-d00c6a62 { background: #fdf6ec; color: #e6a23c;
}
.type-poster.data-v-d00c6a62 { background: #f0f9eb; color: #67c23a;
}
/* ★首页改版：分区标题 + 独立数据卡片（页面/横幅背景色由租户主题下发，此处仅中性卡片面） */
.section-title.data-v-d00c6a62 { flex-shrink: 0; display: block; font-size: 30rpx; font-weight: bold; color: var(--text, #303133); margin: 4rpx 0 12rpx;
}
.stat-grid.data-v-d00c6a62 { flex-shrink: 0; display: flex; flex-wrap: wrap; justify-content: space-between;
}
.stat-card.data-v-d00c6a62 { width: 48.5%; box-sizing: border-box; background: var(--card-bg, #fff); border-radius: var(--radius-card, 16rpx); padding: 20rpx 24rpx; margin-bottom: 14rpx; box-shadow: var(--shadow-card, 0 2rpx 12rpx rgba(0, 0, 0, 0.04));
}
.stat-card.full.data-v-d00c6a62 { width: 100%;
}
.stat-label.data-v-d00c6a62 { display: block; font-size: 24rpx; color: var(--text-sub, #606266);
}
.stat-num.data-v-d00c6a62 { display: block; font-size: 40rpx; font-weight: bold; margin-top: 8rpx;
}
.stat-num.c-income.data-v-d00c6a62 { color: #67c23a;
}
.stat-num.c-expense.data-v-d00c6a62 { color: #f56c6c;
}
.stat-num.c-dark.data-v-d00c6a62 { color: var(--text, #303133);
}
.stat-sub.data-v-d00c6a62 { display: block; font-size: 24rpx; color: var(--brand, #409eff); margin-top: 6rpx;
}
/* ★V3.7 成本构成（卡片吸收一屏剩余高度，超出隐藏不滚动） */
.card.cost-card.data-v-d00c6a62 { flex: 1; overflow: hidden; margin-bottom: 0; padding: 24rpx 32rpx;
}
.cost-row.data-v-d00c6a62 { display: flex; align-items: center; padding: 10rpx 0;
}
.cost-name.data-v-d00c6a62 { width: 140rpx; font-size: 24rpx; color: var(--text-sub, #606266); flex-shrink: 0;
}
.cost-bar.data-v-d00c6a62 { flex: 1; height: 16rpx; background: var(--brand-weak, #f0f2f5); border-radius: 8rpx; overflow: hidden; margin: 0 16rpx;
}
.cost-bar-inner.data-v-d00c6a62 { height: 100%; border-radius: 8rpx;
}
.cost-amount.data-v-d00c6a62 { width: 220rpx; text-align: right; font-size: 22rpx; color: var(--text-sub, #909399); flex-shrink: 0;
}
.loading.data-v-d00c6a62, .empty.data-v-d00c6a62 { text-align: center; color: var(--text-sub, #909399); font-size: 26rpx; padding: 40rpx 0;
}

/* ★手绘主题装饰贴纸 */
.page.data-v-d00c6a62 { position: relative;
}
.sticker.data-v-d00c6a62 { position: absolute; opacity: .8; pointer-events: none; z-index: 0;
}
.welcome-bar.data-v-d00c6a62, .stat-card.data-v-d00c6a62, .cost-card.data-v-d00c6a62 { position: relative; z-index: 1;
}
.sticker-star-tl.data-v-d00c6a62 { top: 10rpx; left: 10rpx; width: 48rpx; height: 48rpx; transform: rotate(-10deg);
}
.sticker-sparkle-tl.data-v-d00c6a62 { top: 30rpx; left: 50rpx; width: 32rpx; height: 32rpx; transform: rotate(15deg);
}
.sticker-bubble-welcome.data-v-d00c6a62 { top: 16rpx; right: 16rpx; width: 52rpx; height: 52rpx; transform: rotate(8deg);
}
.sticker-cloud-welcome.data-v-d00c6a62 { top: 40rpx; right: 6rpx; width: 64rpx; height: 52rpx; transform: rotate(-5deg);
}
.sticker-cloud-profit.data-v-d00c6a62 { top: 16rpx; right: 16rpx; width: 56rpx; height: 44rpx; transform: rotate(5deg);
}
