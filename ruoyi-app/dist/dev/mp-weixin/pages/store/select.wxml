<view class="store-select data-v-e965526f"><view class="hero data-v-e965526f"><view class="hero-title data-v-e965526f">选择门店</view><view class="hero-sub data-v-e965526f">请选择您要进入的企业/门店，随后使用该门店账号登录</view></view><view class="loc-bar data-v-e965526f"><view class="loc-text data-v-e965526f"><text wx:if="{{a}}" class="data-v-e965526f">正在定位…</text><text wx:elif="{{b}}" class="data-v-e965526f">已定位{{c}}（按距离就近排序）</text><text wx:else class="loc-warn data-v-e965526f">未获取定位，可手动输入城市或按名称搜索</text></view><text class="loc-btn data-v-e965526f" bindtap="{{e}}">{{d}}</text></view><view class="search-box data-v-e965526f"><input class="search-input data-v-e965526f" placeholder="搜索门店名称/编码" confirm-type="search" bindconfirm="{{f}}" value="{{g}}" bindinput="{{h}}"/><input class="search-input city data-v-e965526f" placeholder="城市（可选）" confirm-type="search" bindconfirm="{{i}}" value="{{j}}" bindinput="{{k}}"/><button class="search-btn data-v-e965526f" size="mini" bindtap="{{l}}">搜索</button></view><view wx:if="{{m}}" class="section data-v-e965526f"><view class="section-title data-v-e965526f">归属门店</view><view class="card pinned data-v-e965526f" bindtap="{{s}}"><view class="card-main data-v-e965526f"><view class="card-name data-v-e965526f">{{n}}</view><view class="card-meta data-v-e965526f"><text wx:if="{{o}}" class="code data-v-e965526f">{{p}}</text><text wx:if="{{q}}" class="tag data-v-e965526f">{{r}}</text></view></view><text class="arrow data-v-e965526f">›</text></view></view><view wx:if="{{t}}" class="section data-v-e965526f"><view class="section-title data-v-e965526f">已绑定门店</view><view wx:for="{{v}}" wx:for-item="item" wx:key="h" class="card data-v-e965526f" bindtap="{{item.i}}"><view class="logo-placeholder data-v-e965526f">{{item.a}}</view><view class="card-main data-v-e965526f"><view class="card-name data-v-e965526f">{{item.b}} <text wx:if="{{item.c}}" class="tag default data-v-e965526f">默认</text></view><view class="card-meta data-v-e965526f"><text wx:if="{{item.d}}" class="code data-v-e965526f">{{item.e}}</text><text wx:if="{{item.f}}" class="tag data-v-e965526f">{{item.g}}</text></view></view><text class="arrow data-v-e965526f">›</text></view></view><view class="section data-v-e965526f"><view class="section-title data-v-e965526f">{{w}}</view><view wx:if="{{x}}" class="tip data-v-e965526f">加载中…</view><block wx:else><view wx:for="{{y}}" wx:for-item="item" wx:key="q" class="card data-v-e965526f" bindtap="{{item.r}}"><image wx:if="{{item.a}}" class="logo data-v-e965526f" src="{{item.b}}" mode="aspectFill"/><view wx:else class="logo-placeholder data-v-e965526f">{{item.c}}</view><view class="card-main data-v-e965526f"><view class="card-name data-v-e965526f">{{item.d}}</view><view class="card-addr data-v-e965526f"><text wx:if="{{item.e}}" class="city-name data-v-e965526f">{{item.f}}</text><text wx:if="{{item.g}}" class="data-v-e965526f">{{item.h}}</text></view><view wx:if="{{item.i}}" class="card-intro data-v-e965526f">{{item.j}}</view><view class="card-meta data-v-e965526f"><text wx:if="{{item.k}}" class="tag biz data-v-e965526f">{{item.l}}</text><text wx:if="{{item.m}}" class="tag data-v-e965526f">{{item.n}}</text></view></view><view class="card-right data-v-e965526f"><text wx:if="{{item.o}}" class="distance data-v-e965526f">{{item.p}}</text><text class="arrow data-v-e965526f">›</text></view></view><view wx:if="{{z}}" class="empty data-v-e965526f"><view class="empty-text data-v-e965526f">未找到匹配门店</view><view class="empty-sub data-v-e965526f">请调整关键字/城市，或开启定位后重试</view></view></block></view></view>