    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    "h5" : {
        "router" : {
            "mode" : "hash",
            "base" : "/h5/"
        },
        "devServer" : {
            "port" : 3000,
            "disableHostCheck" : true,
            "proxy" : {
                "/prod-api" : {
                    "target" : "http://localhost:8080",
                    "changeOrigin" : true,
                    "pathRewrite" : { "^/prod-api" : "" }
                }
            }
        },
        "title" : "阿杰小账本"
    },
    "mp-weixin" : {
        "appid" : "wxbdff73d9efdd097b",
        "setting" : {
            "urlCheck" : false,
            "es6" : true,
            "minified" : true
        },
        "usingComponents" : true,
        "requiredPrivateInfos" : [ "getLocation" ],
        "permission" : {
            "scope.userLocation" : {
                "desc" : "用于门店就近推荐与高级版报销打卡考勤校验，需要获取您的位置信息"
            }
        }
