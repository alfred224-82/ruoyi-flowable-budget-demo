# 页面标题
VUE_APP_TITLE = 阿杰小账本

# 生产环境配置
ENV = 'production'

# 若依管理系统/生产环境
VUE_APP_BASE_API = '/prod-api'

# 应用访问路径 例如使用前缀 /admin/
VUE_APP_CONTEXT_PATH = '/'

# 监控地址
VUE_APP_MONITRO_ADMIN = '/admin/login'

# xxl-job 控制台地址
VUE_APP_XXL_JOB_ADMIN = '/xxl-job-admin'

# ★ 备案信息（登录页 + 后台底部展示，与手机端 src/config/index.js 的 icp 保持一致）
VUE_APP_ICP_NUMBER = 沪ICP备2026055242号
VUE_APP_ICP_LINK = https://beian.miit.gov.cn/
VUE_APP_POLICE_NUMBER = 沪公网安备31011502408084号
VUE_APP_POLICE_LINK = https://beian.mps.gov.cn/#/query/webSearch?code=31011502408084
# 公安徽章：public 下的文件名（自动拼部署前缀）或完整 URL，置空则用内置官方徽章
VUE_APP_POLICE_ICON = police-badge.png

