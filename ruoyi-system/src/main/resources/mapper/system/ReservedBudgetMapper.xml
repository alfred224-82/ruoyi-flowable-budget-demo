<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ReservedBudgetMapper">
    <resultMap id="ReservedBudgetResult" type="com.ruoyi.system.domain.ReservedBudget">
        <id property="id" column="id"/>
        <result property="budgetPeriod" column="budget_period"/>
        <result property="levelType" column="level_type"/>
        <result property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="allocatedAmount" column="allocated_amount"/>
        <result property="availableAmount" column="available_amount"/>
        <result property="warningThreshold" column="warning_threshold"/>
        <result property="creatorId" column="creator_id"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <!-- 悲观锁查询预留预算行 -->
    <select id="selectForUpdate" resultMap="ReservedBudgetResult">
        SELECT * FROM fee_reserved_budget WHERE id = #{id} FOR UPDATE
    </select>
</mapper>
